# YouTube Data API v3 key (get from https://console.cloud.google.com/)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Notion Internal Integration Token (get from https://developers.notion.com/)
NOTION_API_KEY=your_notion_integration_token_here

# Notion Database ID — the existing database where playlist pages will be added
# (Share this database with your integration!)
NOTION_DATABASE_ID=your_notion_database_id_here

# Server port (default: 3000)
PORT=3000
